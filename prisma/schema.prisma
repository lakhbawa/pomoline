generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id        String   @id @default(cuid())
  text      String
  stage     String   @default("RAW")
  priority  String   @default("UNSET")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  steps     Step[]
  pomoBlocks PomoBlock[]
}

model Step {
  id            String  @id @default(cuid())
  taskId        String
  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text          String
  doneCondition String?
  estimateMins  Int?
  order         Int
}

model PomoBlock {
  id         String    @id @default(cuid())
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  steps      String    @default("[]")
  totalMins  Int       @default(0)
  window     String?
  assignedAt DateTime?
  date       DateTime?
}
